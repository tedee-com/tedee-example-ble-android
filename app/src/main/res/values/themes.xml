<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. -->
  <style name="Theme.TedeeDemo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <!-- Primary brand color. -->
    <item name="colorPrimary">@color/purple_500</item>
    <item name="colorPrimaryVariant">@color/purple_700</item>
    <item name="colorOnPrimary">@color/white</item>
    <!-- Secondary brand color. -->
    <item name="colorSecondary">@color/teal_200</item>
    <item name="colorSecondaryVariant">@color/teal_700</item>
    <item name="colorOnSecondary">@color/black</item>
    <!-- Status bar color. -->
    <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    <!-- Customize your theme here. -->
  </style>

  <style name="Theme.TedeeDemo.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
  </style>

  <style name="Theme.TedeeDemo.SplashScreen" parent="Theme.SplashScreen">
    <!-- Splash screen background color (Android 12+) -->
    <item name="windowSplashScreenBackground">@color/splash_grey</item>
    <!-- Fallback for older Android versions -->
    <item name="android:windowBackground">@color/splash_grey</item>
    <item name="android:statusBarColor">@color/splash_grey</item>
    <!-- Theme to use after splash screen -->
    <item name="postSplashScreenTheme">@style/Theme.TedeeDemo.NoActionBar</item>
  </style>

  <style name="Theme.TedeeDemo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

  <style name="Theme.TedeeDemo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>